{
	frankenphp
	auto_https off
}

{$PORT:80}

root * /app/public
encode zstd gzip

php_server {
	try_files {path} {path}/ /index.php?{query}
}

@static {
	path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.webp *.avif
}
header @static Cache-Control "public, max-age=31536000, immutable"